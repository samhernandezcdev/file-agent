    "DestinationCategory": {
      "description": "A logical organization destination \u2014 not a filesystem path, absolute\nor relative. Resolving this into an actual location (organization root,\ncategory folder, filename) is explicitly deferred to a future ticket;\nthis enum exists only to constrain proposals to a small, stable, typed\nvocabulary instead of letting arbitrary strings (\"Docs\", \"documents/\",\nad-hoc casing) enter durable proposal records.",
      "enum": [
        "documents",
        "images",
        "audio",
        "video",
        "archives",
        "code",
        "executables"
      ],
      "title": "DestinationCategory",
      "type": "string"
